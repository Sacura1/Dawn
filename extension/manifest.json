{
  "manifest_version": 3,
  "name": "Dawn",
  "version": "0.1.0",
  "description": "See Nansen-powered token information directly on X.",
  "icons": {
    "16": "icons/dawn-16.png",
    "32": "icons/dawn-32.png",
    "48": "icons/dawn-48.png",
    "128": "icons/dawn-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "http://localhost:8787/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Dawn",
    "default_icon": {
      "16": "icons/dawn-16.png",
      "32": "icons/dawn-32.png",
      "48": "icons/dawn-48.png"
    },
    "default_popup": "src/popup/index.html"
  }
}